        <item name="colorPrimaryVariant">@color/globalgen_teal_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/globalgen_gray</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@color/globalgen_teal_dark</item>
